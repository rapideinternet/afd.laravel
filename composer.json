{
  "name": "sivi/afd.laravel",
  "type": "library",
  "description": "Laravel implementation for the AFD standard",
  "version": "5.0.0",
  "keywords": [
    "laravel",
    "SIVI",
    "Financial",
    "AFD",
    "GIM",
    "SKP",
    "ADN"
  ],
  "homepage": "https://github.com/rapideinternet/afd.laravel",
  "license": "MIT",
  "authors": [
    {
      "name": "Peter Mein",
      "email": "peter@rapide.software"
    },
    {
      "name": "Lucas van der Have",
      "email": "lucas@dossierdata.nl"
    }
  ],
  "prefer-stable": true,
  "require": {
    "php": "^8.2",
    "laravel/framework": "^10.0 || ^11.0 || ^12.0",
    "guzzlehttp/guzzle": "^7.2",
    "doctrine/dbal": "^3.0",
    "sivi/afd": "^3",
    "sivi/afd.connectors": "^2"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6 || ^10.5",
    "orchestra/database": "^7.0 || ^8.0 || ^9.0",
    "orchestra/testbench": "^7.0 || ^8.0 || ^9.0"
  },
  "autoload": {
    "psr-4": {
      "SIVI\\LaravelAFD\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "SIVI\\LaravelAFD\\Providers\\AfdServiceProvider"
      ]
    }
  }
}
